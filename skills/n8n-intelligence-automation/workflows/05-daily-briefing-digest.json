{
  "name": "05. Daily Briefing Digest (6 AM)",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": [
          {
            "hour": 6,
            "minute": 0
          }
        ]
      },
      "id": "node-cron",
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/{{ $env.AIRTABLE_BASE_ID }}/Feed%20Items"
      },
      "id": "node-fetch",
      "name": "Fetch briefing items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items=($json.records||[]).map(r=>r.fields); let markdown='# Daily Intelligence Briefing\\n\\n'; for (const item of items.slice(0,10)) markdown += `- **${item.title}** — ${item.combined_score||'n/a'}\\n`; return {markdown,item_count:items.length,briefing_date:new Date().toISOString().slice(0,10)};"
      },
      "id": "node-brief",
      "name": "Generate briefing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/me/sendMail",
        "body": "={{ {message:{subject:`Daily Intelligence Briefing - ${$json.briefing_date}`,body:{contentType:'Text',content:$json.markdown}}} }}"
      },
      "id": "node-email",
      "name": "Send email briefing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        750,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{ $env.TEAMS_WEBHOOK_BRIEFING }}",
        "body": "={{ {text:$json.markdown} }}"
      },
      "id": "node-teams",
      "name": "Send Teams briefing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        750,
        400
      ]
    }
  ],
  "connections": {
    "node-cron": {
      "main": [
        [
          {
            "node": "node-fetch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "node-fetch": {
      "main": [
        [
          {
            "node": "node-brief",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "node-brief": {
      "main": [
        [
          {
            "node": "node-email",
            "type": "main",
            "index": 0
          },
          {
            "node": "node-teams",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "meta": {
    "pca209_repaired": true,
    "note": "Syntactically normalized example; credentials remain environment references."
  }
}
