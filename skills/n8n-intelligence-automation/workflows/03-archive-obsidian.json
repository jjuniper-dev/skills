{
  "name": "03. Archive to Obsidian Vault",
  "nodes": [
    {
      "parameters": {
        "waitForWebhook": true
      },
      "id": "node-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item=$json; const slug=(item.title||'item').toLowerCase().replace(/[^a-z0-9]+/g,'-').slice(0,40); return {...item, filepath:`/Intelligence/Sources/${item.source_tier}/${slug}.md`};"
      },
      "id": "node-path",
      "name": "Generate path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item=$json; return {...item, markdown:`# ${item.title}\\n\\n${item.summary||''}\\n\\nSource: ${item.link||''}`};"
      },
      "id": "node-markdown",
      "name": "Generate markdown",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://{{ $env.OBSIDIAN_VAULT_HOST }}/api/write",
        "body": "={{ {path: $json.filepath, content: $json.markdown} }}"
      },
      "id": "node-write",
      "name": "Write to Obsidian Vault",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.airtable.com/v0/{{ $env.AIRTABLE_BASE_ID }}/Feed%20Items",
        "body": "={{ {records:[{fields:{obsidian_path:$json.filepath}}]} }}"
      },
      "id": "node-log",
      "name": "Log archive metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "node-webhook": {
      "main": [
        [
          {
            "node": "node-path",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "node-path": {
      "main": [
        [
          {
            "node": "node-markdown",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "node-markdown": {
      "main": [
        [
          {
            "node": "node-write",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "node-write": {
      "main": [
        [
          {
            "node": "node-log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "meta": {
    "pca209_repaired": true,
    "note": "Syntactically normalized example; credentials remain environment references."
  }
}
