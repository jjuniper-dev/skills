{
  "name": "06. Feed Health & Metrics Monitor",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": [
          {
            "hour": 7,
            "minute": 0
          }
        ]
      },
      "id": "node-cron",
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/{{ $env.AIRTABLE_BASE_ID }}/Feed%20Items?maxRecords=1000"
      },
      "id": "node-fetch",
      "name": "Fetch feed items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items=($json.records||[]).map(r=>r.fields); const by={}; for(const i of items){const s=i.source||'Unknown'; by[s]=(by[s]||0)+1;} return {total_sources:Object.keys(by).length,total_items_7d:items.length,source_counts:by};"
      },
      "id": "node-analyze",
      "name": "Analyze health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return {...$json,report:`# Feed Health Report\\n\\nSources: ${$json.total_sources}\\nItems: ${$json.total_items_7d}`};"
      },
      "id": "node-report",
      "name": "Generate report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.airtable.com/v0/{{ $env.AIRTABLE_BASE_ID }}/Feed%20Health",
        "body": "={{ {records:[{fields:{total_sources:$json.total_sources,total_items_7d:$json.total_items_7d,report:$json.report}}]} }}"
      },
      "id": "node-log",
      "name": "Log health metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        250
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{ $env.TEAMS_WEBHOOK_ADMIN }}",
        "body": "={{ {text:$json.report} }}"
      },
      "id": "node-alert",
      "name": "Send admin report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        400
      ]
    }
  ],
  "connections": {
    "node-cron": {
      "main": [
        [
          {
            "node": "node-fetch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "node-fetch": {
      "main": [
        [
          {
            "node": "node-analyze",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "node-analyze": {
      "main": [
        [
          {
            "node": "node-report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "node-report": {
      "main": [
        [
          {
            "node": "node-log",
            "type": "main",
            "index": 0
          },
          {
            "node": "node-alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "meta": {
    "pca209_repaired": true,
    "note": "Syntactically normalized example; credentials remain environment references."
  }
}
