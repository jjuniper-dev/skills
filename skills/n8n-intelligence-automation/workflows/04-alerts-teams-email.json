{
  "name": "04. Real-Time Alerts (Teams + Email)",
  "nodes": [
    {
      "parameters": {
        "waitForWebhook": true
      },
      "id": "node-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item=$json; return {...item, alertText:`${item.title} — Score ${item.combinedScore}/100\\n${item.summary||''}\\n${item.link||''}`};"
      },
      "id": "node-format",
      "name": "Format alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{ $env.TEAMS_WEBHOOK_ALERTS }}",
        "body": "={{ {text:$json.alertText} }}"
      },
      "id": "node-teams",
      "name": "Send Teams alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        550,
        200
      ]
    },
    {
      "parameters": {
        "fromEmail": "{{ $env.EMAIL_FROM }}",
        "toEmail": "{{ $env.EMAIL_ALERTS_LIST }}",
        "subject": "[INTELLIGENCE ALERT] {{ $json.title }}",
        "text": "{{ $json.alertText }}"
      },
      "id": "node-email",
      "name": "Send email alert",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [
        550,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.airtable.com/v0/{{ $env.AIRTABLE_BASE_ID }}/Alerts",
        "body": "={{ {records:[{fields:{title:$json.title,score:$json.combinedScore,status:'DELIVERED'}}]} }}"
      },
      "id": "node-log",
      "name": "Log alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        800,
        300
      ]
    }
  ],
  "connections": {
    "node-webhook": {
      "main": [
        [
          {
            "node": "node-format",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "node-format": {
      "main": [
        [
          {
            "node": "node-teams",
            "type": "main",
            "index": 0
          },
          {
            "node": "node-email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "node-teams": {
      "main": [
        [
          {
            "node": "node-log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "node-email": {
      "main": [
        [
          {
            "node": "node-log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "meta": {
    "pca209_repaired": true,
    "note": "Syntactically normalized example; credentials remain environment references."
  }
}
