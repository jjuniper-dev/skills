{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skills Repository Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "release_revision", "skills"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "repository": {"const": "https://github.com/jjuniper-dev/skills"},
    "release_revision": {"type": "string", "minLength": 1},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "version", "status", "contract_version",
          "source_path", "source_revision", "source_sha256",
          "runtimes", "authority_class", "mutation_level",
          "capabilities", "evidence_requirements"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "status": {"enum": ["production", "experimental", "legacy", "deprecated"]},
          "contract_version": {"enum": ["1.0", "2.0"]},
          "source_path": {"type": "string", "pattern": "^skills/.+/SKILL\\.md$"},
          "contract_path": {"type": "string", "pattern": "^skills/.+/skill\\.yaml$"},
          "source_revision": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "runtimes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "authority_class": {"type": "string"},
          "mutation_level": {"type": "string"},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "evidence_requirements": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
